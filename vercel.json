{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/evaluate-alerts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reports-and-strategies",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "app/api/cron/**/*.ts": {
      "maxDuration": 300
    },
    "app/api/ai/ask/route.ts": {
      "maxDuration": 120
    },
    "app/api/reports/**/*.ts": {
      "maxDuration": 60
    }
  }
}
